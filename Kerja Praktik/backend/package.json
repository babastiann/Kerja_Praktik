{
  "name": "backend-rumah-bandung",
  "version": "1.0.0",
  "description": "Backend API Sistem Prediksi Harga Rumah Bandung",
  "main": "server.js",
  "scripts": {
    "start":     "node server.js",
    "dev":       "nodemon server.js",
    "ml":        "uvicorn ml.ml_service:app --host 0.0.0.0 --port 8000 --reload",
    "ml:install": "pip install fastapi uvicorn scikit-learn pandas numpy joblib"
  },
  "dependencies": {
    "axios":      "^1.7.2",
    "bcryptjs":   "^3.0.3",
    "cors":       "^2.8.6",
    "csv-parse":  "^5.5.6",
    "dotenv":     "^17.4.2",
    "express":    "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer":     "^2.1.1",
    "pg":         "^8.20.0"
  },
  "devDependencies": {
    "nodemon":    "^3.1.4"
  }
}
